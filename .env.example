# Copie este arquivo para ".env" (opcional, os valores abaixo já são o default do docker-compose.yml)
POSTGRES_USER=hospital
POSTGRES_PASSWORD=hospital123
POSTGRES_DB=hospital_db
POSTGRES_PORT=5432

# Seed carregado na criação do banco (relativo a ./database). O padrão é o oficial;
# seeds/cenarios.sql cobre todas as regras do Farol. Trocar exige recriar o volume:
#   docker compose down -v && docker compose up --build
# SEED_FILE=seeds/cenarios.sql

# Porta exposta do Adminer (cliente web para o banco)
ADMINER_PORT=8080

# Porta exposta da API
API_PORT=3001

# Porta exposta do frontend
WEB_PORT=3000
