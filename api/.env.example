# Copie para "api/.env" para rodar a API fora do Docker (npm run dev:api).
# Aponta para o Postgres do compose; ajuste a porta se mudou POSTGRES_PORT no .env da raiz.
DATABASE_URL=postgres://hospital:hospital123@localhost:5432/hospital_db
# PORT=3001

# Testes de integração (npm run test:integration) usam o banco "hospital_test" no
# mesmo servidor da DATABASE_URL, criado e apagado pelos próprios testes.
# TEST_DATABASE_URL=postgres://hospital:hospital123@localhost:5432/hospital_test
